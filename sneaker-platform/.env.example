# Veritabanı
# Boş bırakılırsa proje içindeki gömülü veritabanı (.data/db) kullanılır; Docker/PostgreSQL gerekmez.
# Canlı sunucuda PostgreSQL adresi girin, örn: postgresql://sneaker:sifre@localhost:5432/sneaker
DATABASE_URL=

# Panel bu alan adlarından açılır (virgülle ayır). Diğer tüm alan adları mağaza sitesi olarak çözülür.
ADMIN_HOSTS=localhost:3000,127.0.0.1:3000

# Her site otomatik olarak {slug}.ROOT_DOMAIN adresinden de yayınlanır.
ROOT_DOMAIN=localhost:3000

# Platformun dışarıdan erişilen adresi (Shopier webhook ve görsel URL'leri için)
PLATFORM_URL=http://localhost:3000

# Oturum imzalama anahtarı (en az 32 karakter, rastgele)
AUTH_SECRET=degistir-en-az-32-karakter-rastgele-bir-anahtar

# E-posta (isteğe bağlı; boşsa e-postalar konsola yazılır)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Gemini (isteğe bağlı; panelden de girilebilir)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
